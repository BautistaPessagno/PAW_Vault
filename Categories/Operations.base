{
  "filters": {
    "and": [
      "file.ext == \"md\"",
      "list(categories).contains(\"Operations\")",
      "type != \"template\""
    ]
  },
  "properties": {
    "file.name": {
      "displayName": "Note"
    },
    "module": {
      "displayName": "Module"
    },
    "type": {
      "displayName": "Kind"
    },
    "snapshot": {
      "displayName": "Source snapshot"
    }
  },
  "views": [
    {
      "type": "table",
      "name": "Operations",
      "order": [
        "file.name",
        "type",
        "module",
        "snapshot"
      ],
      "sort": [
        {
          "property": "file.name",
          "direction": "ASC"
        }
      ]
    },
    {
      "type": "cards",
      "name": "Browse",
      "order": [
        "file.name",
        "module",
        "type"
      ]
    }
  ]
}
